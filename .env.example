# Environment Configuration
ENVIRONMENT=development
SECRET_KEY=change_this_to_a_secure_random_key_in_production_32chars
API_PORT=8000
FRONTEND_PORT=8080

# Allowed Campus Email Domains (comma-separated)
ALLOWED_EMAIL_DOMAINS=campus.edu,student.campus.edu

# PostgreSQL with pgvector
POSTGRES_USER=campus_user
POSTGRES_PASSWORD=campus_secure_password
POSTGRES_DB=campus_lost_and_found
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://campus_user:campus_secure_password@db:5432/campus_lost_and_found
SYNC_DATABASE_URL=postgresql+psycopg://campus_user:campus_secure_password@db:5432/campus_lost_and_found

# Mail / SMTP (Mailpit in development)
SMTP_HOST=mail
SMTP_PORT=1025
SMTP_FROM=no-reply@campus.edu

# Retention Periods (in days)
RETENTION_UNCLAIMED_FOUND_DAYS=90
RETENTION_CLOSED_IMAGE_DAYS=30
RETENTION_CLOSED_CLAIM_EVIDENCE_DAYS=30
RETENTION_AUDIT_LOG_DAYS=365

# ML Models
TEXT_MODEL_NAME=all-MiniLM-L6-v2
TEXT_MODEL_VERSION=v1
CLIP_MODEL_NAME=ViT-B/32
CLIP_MODEL_VERSION=v1

# Security & CORS
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://127.0.0.1:8080
SESSION_MAX_AGE_SECONDS=604800
